{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suku-docs",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-14",
  // renderToMarkdown (fumadocs-core/server) uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Pull-request builds deploy with `wrangler preview`, which needs this block. It can stay
  // empty: assets and compatibility settings are read from the top level.
  "previews": {}
}
