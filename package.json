{
  "name": "suku-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "benchmarks"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test && bun run test:node",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "bun scripts/size.ts",
    "check": "bun run version:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run size",
    "test:node": "bun run --filter '@sukujs/crypto' build && node --experimental-strip-types --test 'packages/*/test/*.node-test.ts'",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "version:check": "bun scripts/version.ts check",
    "version:set": "bun scripts/version.ts set",
    "version:bump": "bun scripts/version.ts bump",
    "release:dry-run": "bun run build && bun scripts/publish.ts --dry-run",
    "release:publish": "bun run check && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
