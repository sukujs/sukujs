{
  "name": "suku-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "benchmarks"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test packages examples/hello examples/lifecycle examples/database examples/deploy examples/graphql examples/base && bun run test:node",
    "lint": "eslint .",
    "format": "prettier --write .",
    "suku": "bun packages/cli/src/bin.ts",
    "size": "bun scripts/size.ts",
    "check": "bun run version:check && bun run lint && bun run typecheck && bun run build && bun run test && bun run size",
    "test:node": "bun run --filter '@sukujs/crypto' build && node --experimental-strip-types --test 'packages/*/test/*.node-test.ts'",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "version:check": "bun scripts/version.ts check",
    "version:set": "bun scripts/version.ts set",
    "version:bump": "bun scripts/version.ts bump",
    "release:dry-run": "bun run build && bun scripts/publish.ts --dry-run",
    "release:publish": "bun run check && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.46.4"
  }
}
