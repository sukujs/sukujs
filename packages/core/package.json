{
  "name": "@sukujs/core",
  "version": "0.0.0",
  "description": "Suku HTTP kernel: platform adapter contract, radix router, modules, controllers and request pipeline.",
  "keywords": [
    "suku",
    "framework",
    "backend",
    "api",
    "http",
    "routes",
    "dependency-injection",
    "typescript",
    "bun",
    "node"
  ],
  "license": "MIT",
  "author": "Suku Authors",
  "homepage": "https://github.com/sukujs/sukujs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukujs/sukujs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sukujs/sukujs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sukujs/di": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
