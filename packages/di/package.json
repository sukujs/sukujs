{
  "name": "@suku/di",
  "version": "0.0.0",
  "description": "Zero-dependency dependency injection container with .NET-style lifetimes (singleton, scoped, transient).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/metadata.*",
    "./src/metadata.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  }
}
