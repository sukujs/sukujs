{
  "name": "@suku/graphql",
  "version": "0.0.0",
  "description": "Class-based GraphQL resolvers for Suku, with constructor injection and typed arguments. Built on GraphQL Yoga.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@suku/core": "workspace:*",
    "@suku/di": "workspace:*"
  },
  "peerDependencies": {
    "graphql": ">=16",
    "graphql-yoga": ">=5"
  },
  "devDependencies": {
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "zod": "^4.6.7"
  }
}
