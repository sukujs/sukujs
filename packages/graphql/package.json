{
  "name": "@sukujs/graphql",
  "version": "0.1.0",
  "description": "Class-based GraphQL resolvers for Suku, with constructor injection and typed arguments. Built on GraphQL Yoga.",
  "keywords": [
    "suku",
    "graphql",
    "graphql-yoga",
    "resolvers",
    "typescript"
  ],
  "license": "MIT",
  "author": "Suku Authors",
  "homepage": "https://github.com/sukujs/sukujs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukujs/sukujs.git",
    "directory": "packages/graphql"
  },
  "bugs": {
    "url": "https://github.com/sukujs/sukujs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sukujs/core": "workspace:*",
    "@sukujs/di": "workspace:*"
  },
  "peerDependencies": {
    "graphql": ">=16",
    "graphql-yoga": ">=5"
  },
  "devDependencies": {
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
