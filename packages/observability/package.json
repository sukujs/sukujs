{
  "name": "@sukujs/observability",
  "version": "0.5.0",
  "description": "Observability for Suku with OpenTelemetry: request traces, logs, errors and runtime metrics sent to any OTLP endpoint, as one middleware.",
  "keywords": [
    "suku",
    "opentelemetry",
    "otlp",
    "observability",
    "tracing",
    "logging",
    "middleware"
  ],
  "license": "MIT",
  "author": "Suku Authors",
  "homepage": "https://github.com/sukujs/sukujs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukujs/sukujs.git",
    "directory": "packages/observability"
  },
  "bugs": {
    "url": "https://github.com/sukujs/sukujs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@sukujs/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
