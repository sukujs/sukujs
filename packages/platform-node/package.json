{
  "name": "@suku/platform-node",
  "version": "0.0.0",
  "description": "Suku platform adapter for node:http.",
  "keywords": [
    "suku",
    "adapter",
    "node",
    "http"
  ],
  "license": "MIT",
  "author": "Suku Authors",
  "homepage": "https://github.com/sukujs/sukujs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukujs/sukujs.git",
    "directory": "packages/platform-node"
  },
  "bugs": {
    "url": "https://github.com/sukujs/sukujs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@suku/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
